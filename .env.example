# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (Project Settings → API). Safe to expose to the browser.
# When both NEXT_PUBLIC_SUPABASE_* values are set, plans are stored in Supabase and visitors are
# signed in anonymously (enable Authentication → Sign In / Providers → Anonymous sign-ins).
# When unset, plans stay in the browser on this device.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. Safe to expose; row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. Server only; bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side encryption for user-supplied AI provider credentials (BYO keys).
# Generate a random 32-byte key and base64-encode it; keep it separate from Supabase credentials.
# Required only when BYO credentials are enabled. Never expose this as NEXT_PUBLIC_*.
KEEPLY_AI_KEY_ENCRYPTION_KEY=

# Google OAuth client ID for Calendar access (Google Cloud console).
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Server only.
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI registered with Google, e.g. http://localhost:3000/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Phase 2: "Scan appliance" (label photo → AI proposal or Manual → Confirm / Edit / Rescan). Off unless set to 1.
# Read at build time. AI reading needs a personal BYO key or MINIMAX_API_KEY below; otherwise Manual.
NEXT_PUBLIC_KEEPLY_SCAN=

# App/self-hoster AI provider for label reading (server only, never NEXT_PUBLIC).
# Unset = personal BYO key when configured, otherwise Manual mode.
# MiniMax: a key whose model accepts images (MiniMax-M3 / MiniMax-M3.1-Flash-Preview; M2.x is text-only).
# Token Plan keys (sk-cp-…) use the same base URL. See docs/ai/minimax.md before enabling.
# In a Claude cloud session use a proxy-injected API credential instead (docs/ai/minimax.md); never a plain env var.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Who may make billable AI scans (server only). Default "invite": invited testers only, with the
# per-tester and daily limits kept in Supabase (scan_limits; defaults 5 per tester and 100 in total
# per UTC day). "open": anyone who can reach the server; only for your own machine or a
# login-protected preview, never a public deployment.
# KEEPLY_SCAN_ACCESS=invite
