# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (Project Settings → API). Safe to expose to the browser.
# When both NEXT_PUBLIC_SUPABASE_* values are set, plans are stored in Supabase and visitors are
# signed in anonymously (enable Authentication → Sign In / Providers → Anonymous sign-ins).
# When unset, plans stay in the browser on this device.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. Safe to expose; row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. Server only; bypasses row-level security.
# Needed for the durable Brave quota. Without it the Brave quota check does nothing.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client ID for Calendar access (Google Cloud console).
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Server only.
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI registered with Google, e.g. http://localhost:3000/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Phase 2: "Scan appliance" (label photo → AI proposal or Manual → Confirm / Edit / Rescan). Off unless set to 1.
# Read at build time. AI reading needs OPENROUTER_API_KEY; otherwise Manual.
NEXT_PUBLIC_KEEPLY_SCAN=

# Phase 3: "Find the manual" (server-only Brave Search adapter in src/search/brave.ts).
# Brave Search API key (https://api.search.brave.com). Server only; never expose as NEXT_PUBLIC_*.
# Unset = manual search returns "unavailable" and the proposer falls back to general guidance.
BRAVE_SEARCH_API_KEY=
# Brave Search free-tier cap per process (default 2000, the documented free quota at the time of
# writing). Brave plan is free-only; on a refused call the per-process counter does NOT advance.
# Override here only for self-hosted tests; production should leave at the default.
BRAVE_FREE_QUOTA_PER_MONTH=2000

# OpenRouter (https://openrouter.ai/api/v1) reads labels and manufacturer manuals. Server only.
# Unset means Manual: the owner types the label, and manual extraction is unavailable.
# A refusal (429, 402, 5xx, routing, timeout, or an error inside a 200 reply) stays on that path.
# There is no backup provider. OPENROUTER_MODEL defaults to openrouter/free.
# OPENROUTER_DATA_COLLECTION defaults to deny (skip providers that may train on prompts). Set allow to opt in.
# Do not set MINIMAX_* or KEEPLY_AI_KEY_ENCRYPTION_KEY; remove them from Vercel after this ships (RF-357).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_DATA_COLLECTION=deny

# Who may make billable AI scans (server only). Default "invite": invited testers only, with the
# per-tester and daily limits kept in Supabase (scan_limits; defaults 5 per tester and 100 in total
# per UTC day). "open": anyone who can reach the server; only for your own machine or a
# login-protected preview, never a public deployment.
# KEEPLY_SCAN_ACCESS=invite

# Full-journey e2e only (server). "1" answers OpenRouter, Brave, the manual download
# and Google OAuth/Calendar from fixtures in e2e/fixtures. Ignored on any Vercel deployment.
# Never set this on a public deployment. The Playwright scan server sets it; leave it unset locally.
# KEEPLY_E2E_FIXTURES=1
